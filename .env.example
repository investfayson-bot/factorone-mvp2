# ==============================================================================
# FactorOne — variáveis de ambiente
# Copie para .env.local e preencha. NÃO commitar segredos.
# (NODE_ENV é definido pelo runtime — não precisa configurar.)
# ==============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only; ignora RLS — nunca expor no client

# --- App / URLs -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- IA: Anthropic (AI CFO, análises) ---------------------------------------
ANTHROPIC_API_KEY=

# --- IA: OpenRouter (OCR de comprovantes/extratos) --------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                   # ex.: anthropic/claude-3.5-sonnet

# --- Stripe (assinaturas) ---------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=

# --- Pluggy (Open Finance / integração bancária) ----------------------------
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# --- NFe.io (emissão de notas) ----------------------------------------------
NFEIO_API_KEY=
NEXT_PUBLIC_NFEIO_API_KEY=          # opcional; só se o build precisar no client
NFEIO_COMPANY_ID=
NFEIO_PRODUCT_BASE_URL=
NFEIO_SERVICE_BASE_URL=
NFEIO_SANDBOX=true

# --- E-mail (Resend) --------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=noreply@seudominio.com
EMAIL_FROM=noreply@seudominio.com

# --- WhatsApp (LifeOS / notificações) ---------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- Secrets de webhooks/cron (obrigatórios em produção) --------------------
CRON_SECRET=                        # protege /api/cron/*
LIFEOS_WEBHOOK_SECRET=              # OBRIGATÓRIO: sem ele o webhook LifeOS retorna 401
LOGISTICA_GPS_SECRET=               # protege /api/logistica/gps-update
