# ==============================================================================
# FactorOne — variáveis de ambiente
# Copie para .env.local e preencha. NÃO commitar segredos.
# (NODE_ENV é definido pelo runtime — não precisa configurar.)
# ==============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only; ignora RLS — nunca expor no client

# --- App / URLs -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# --- IA: Anthropic (AI CFO, análises) ---------------------------------------
ANTHROPIC_API_KEY=

# --- IA: OpenRouter (OCR de comprovantes/extratos) --------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                   # ex.: anthropic/claude-3.5-sonnet

# --- Stripe (assinaturas) ---------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=

# --- Pluggy (Open Finance / integração bancária) ----------------------------
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# --- NFe.io (emissão de notas) ----------------------------------------------
NFEIO_API_KEY=
NEXT_PUBLIC_NFEIO_API_KEY=          # opcional; só se o build precisar no client
NFEIO_COMPANY_ID=
NFEIO_PRODUCT_BASE_URL=
NFEIO_SERVICE_BASE_URL=
NFEIO_SANDBOX=true

# --- E-mail (Resend) --------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=noreply@seudominio.com
EMAIL_FROM=noreply@seudominio.com

# --- WhatsApp (LifeOS / notificações) ---------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=            # opcional, ex.: +55 11 5555-5555 — só pra exibir no modal de vínculo

# --- Telegram (acessor de bolso) ---------------------------------------------
TELEGRAM_BOT_TOKEN=                 # token do @BotFather
TELEGRAM_WEBHOOK_SECRET=            # OBRIGATÓRIO: sem ele o webhook Telegram retorna 401 (usar em setWebhook como secret_token)
TELEGRAM_BOT_USERNAME=              # opcional, ex.: FactorOneBot — só pra exibir link no app

# --- Belvo (Open Finance) — sandbox | development | production --------------
BELVO_ENV=sandbox
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=

# --- Secrets de webhooks/cron (obrigatórios em produção) --------------------
CRON_SECRET=                        # protege /api/cron/*
LIFEOS_WEBHOOK_SECRET=              # OBRIGATÓRIO: sem ele o webhook LifeOS retorna 401
LOGISTICA_GPS_SECRET=               # protege /api/logistica/gps-update
COFRE_SECRET_KEY=                   # chave de criptografia do Cofre (senhas + API keys); gere com `openssl rand -hex 32`

# --- Google OAuth (Gmail — Donna) --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI é montada em runtime como ${NEXT_PUBLIC_APP_URL}/api/google/oauth/callback
# Precisa bater EXATAMENTE com "Authorized redirect URIs" no Google Cloud Console.
# COFRE_SECRET_KEY (acima) é reaproveitada pra assinar o "state" do fluxo OAuth.

# --- BaaS (Banking as a Service) — conta/cartao/PIX de verdade na sua marca ---
# Ative um provider quando fechar contrato. Sem isso, o app usa fluxo simulado.
BAAS_PROVIDER=            # celcoin | dock | swap | matera | qitech
CELCOIN_ENV=sandbox      # sandbox | production
CELCOIN_CLIENT_ID=
CELCOIN_CLIENT_SECRET=

# --- Marketing: Ads + Ecommerce (OAuth/token do provedor) ---
META_ADS_TOKEN=
GOOGLE_ADS_TOKEN=
TIKTOK_ADS_TOKEN=
NUVEMSHOP_TOKEN=
MERCADOLIVRE_TOKEN=
SHOPIFY_TOKEN=
